<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#C5D9FF"
    android:orientation="vertical"
    android:padding="0dp">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:paddingBottom="8dp"
        android:text="Select App Language"
        android:textColor="#000000"
        android:textSize="18sp" />

    <!-- Scrollable list of languages -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxHeight="400dp">

        <RadioGroup
            android:id="@+id/radioGroupLanguages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <RadioButton
                android:id="@+id/rbEnglish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:padding="12dp"
                android:text="English"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbCatala"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="Català"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbCestina"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="Čeština"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbDansk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="Dansk"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbDeutsch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="Deutsch"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbEspanol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="Español"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbFrancais"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="Français"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbHrvatski"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="Hrvatski"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbMagyar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="Magyar"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbBahasa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="bahasa Indonesia"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbIslenska"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="íslenska"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbItaliano"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="Italiano"
                android:textSize="16sp" />

        </RadioGroup>
    </ScrollView>

    <!-- CANCEL button -->
    <TextView
        android:id="@+id/btnCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:padding="16dp"
        android:text="CANCEL"
        android:textColor="#000000"
        android:textSize="14sp" />

</LinearLayout>
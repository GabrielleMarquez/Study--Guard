<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F0F2F5"
    android:padding="24dp">

    <!-- Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="28dp"
        android:elevation="6dp">

        <!-- Logo (simple blue squares) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp">

            <View
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="#4A6CF7"
                android:layout_marginEnd="-10dp" />

            <View
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="#3B5BDB"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Change Your Password"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter a new password below to change your password."
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <!-- New password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New password*"
            android:textSize="14sp"
            android:textColor="#444444"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etNewPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/edit_text"
            android:inputType="textPassword"
            android:padding="12dp" />

        <!-- Re-enter new password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Re-enter new password*"
            android:textSize="14sp"
            android:textColor="#444444"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:inputType="textPassword"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:layout_marginBottom="20dp" />

        <!-- Password requirements box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F8F9FA"
            android:padding="14dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your password must contain:"
                android:textSize="13sp"
                android:textColor="#555555"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvRequirement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓  At least 10 characters in length"
                android:textSize="13sp"
                android:textColor="#2E7D32" />
        </LinearLayout>

        <!-- Reset password button -->
        <Button
            android:id="@+id/btnResetPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Reset password"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#1A73E8"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>

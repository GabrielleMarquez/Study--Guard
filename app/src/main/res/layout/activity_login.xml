<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background"
    tools:context=".LogIn">


<EditText
        android:id="@+id/studentNumber"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Student Number"
        android:inputType="number"
        android:singleLine="true"
        android:padding="10dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="350dp" />

    <EditText
        android:id="@+id/password"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Password"
        android:inputType="textPassword"
        android:singleLine="true"
        android:padding="10dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/studentNumber"
        app:layout_constraintStart_toStartOf="@id/studentNumber"
        app:layout_constraintEnd_toEndOf="@id/studentNumber"
        android:layout_marginTop="2dp" />

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="47dp"
        android:layout_height="67dp"
        android:src="@drawable/aee0de14_793b_4fdc_a208_ef6523da6876_removalai_preview"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp" />

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="55dp"
        android:layout_height="61dp"
        android:scaleType="fitCenter"
        android:src="@drawable/_4e240f1d_c338_4ef1_8e7f_4fd65d418185_removalai_preview"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/imageView3"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="5dp" />

    <TextView
        android:id="@+id/resetPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="reset password"
        android:textColor="#405D65"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="6dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/password"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="2dp" />



    <Button
        android:id="@+id/loginButton"
        android:layout_width="180dp"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/login_button"
        android:text="Log in"
        android:textColor="#000000"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:layout_constraintTop_toBottomOf="@id/resetPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/imageView8"
        android:layout_width="605dp"
        android:layout_height="675dp"
        android:src="@drawable/Login_logo"
        tools:layout_editor_absoluteX="-97dp"
        tools:layout_editor_absoluteY="-16dp" />


</androidx.constraintlayout.widget.ConstraintLayout>
